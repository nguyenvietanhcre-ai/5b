+body.learning-mode .owl-ultimate-active .spell-effect { display:none !important; }
+body.learning-mode .illustrated-arena [data-spell="owl"] .spell-effect { display:none; }
+@media(prefers-reduced-motion:reduce) {
+  body.learning-mode .battle-pet.cu-meo,body.learning-mode .battle-pet.cu-meo * { animation:none !important; transition:none !important; }
