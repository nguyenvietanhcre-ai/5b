+body.learning-mode .battle-pet.cu-meo > .mascot-art { visibility:visible; animation:none; }
+body.learning-mode .battle-pet.cu-meo.owl-ready > .mascot-art { visibility:hidden; }
+body.learning-mode .owl-canvas { display:block; position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
+body.learning-mode .battle-pet.cu-meo.owl-in-ultimate { visibility:hidden; }
+body.learning-mode .owl-ultimate-canvas { position:absolute; inset:0; width:100%; height:100%; z-index:7; pointer-events:none; }
