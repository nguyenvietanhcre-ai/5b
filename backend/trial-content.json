  "lesson": {
    "id": "TRIAL5-LESSON-PERCENT-R1",
    "revision": 1,
    "grade": 5,
    "title": "Tìm giá trị phần trăm của một số",
    "prompt": "Vườn có 80 cây. Có 25% số cây đang nở hoa. Hỏi có bao nhiêu cây đang nở hoa?",
    "source": "Diễn giải tự biên soạn theo ví dụ công khai g5-percent trong baseline/backend/learning-catalog.json; không trích bài từ ngân hàng hoặc nguyên văn SGK.",
    "reviewStatus": "arithmetic_checked",
    "independentTeacherReview": "pending",
    "status": "local_pilot_draft",
    "sections": [
      {
        "key": "thinking",
        "title": "Định hướng tư duy",
        "body": "Em thử nghĩ: 25% có nghĩa là bao nhiêu phần trong 100 phần bằng nhau? Muốn tìm 25% của 80 cây, ta có thể tìm số cây ứng với 1% rồi nhân với 25. Vì 25% = 1/4, em cũng có thể chia 80 cây thành 4 phần bằng nhau."
      },
      {
        "key": "key",
        "title": "Điểm mấu chốt",
        "body": "Toàn bộ 80 cây ứng với 100%. Chỉ lấy 25 phần trong 100 phần ấy, không cộng thêm 25 cây. Cách ngắn: 25% = 1/4 nên tìm một phần tư của 80."
      },
      {
        "key": "detail",
        "title": "Bài giải chi tiết",
        "body": "Số cây đang nở hoa là: 80 × 25 : 100 = 20 (cây). Đáp số: 20 cây. Thử lại: 20 : 80 = 1/4 = 25%, khớp đề bài. Cách khác: 80 : 4 = 20 (cây). Vận dụng: nếu 50% trong 80 cây đang nở hoa thì có bao nhiêu cây? Gợi ý đối chiếu: 50% = 1/2, nên 80 : 2 = 40 (cây)."
      }
    ],
    "diagram": {
      "kind": "equal_parts",
      "parts": 4,
      "selected": 1,
      "labels": [
        "20 cây nở hoa",
        "20 cây",
        "20 cây",
        "20 cây"
      ],
      "description": "80 cây chia thành 4 phần bằng nhau, mỗi phần 20 cây. Một phần ứng với 25%."
    },
    "answer": "20",
    "unit": "cây"
  },
