# Copy to .env locally; do not commit the configured file or share its contents.
# Receiving bank information used in each payment order and its QR.
MAM_TOAN_BANK_ID=ACB
MAM_TOAN_BANK_ACCOUNT=
MAM_TOAN_BANK_NAME=
# Enable only after connecting the receiving bank and configuring the webhook.
MAM_TOAN_SEPAY_ENABLED=0
# Use the same random secret (at least 32 characters) in SePay HMAC-SHA256.
MAM_TOAN_SEPAY_WEBHOOK_SECRET=
# Leave empty for local HTTP; use https://5bmath.vn on the HTTPS production backend.
# HTTPS configuration adds Secure to session cookies. Do not set this on HTTP LAN.
MAM_TOAN_PUBLIC_ORIGIN=
